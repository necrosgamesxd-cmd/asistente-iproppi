# Secrets para Streamlit Community Cloud — Settings → Advanced settings → Secrets
# Copia este contenido y rellena los valores.

# Rotación de keys LLM separadas por coma (si una da 429, se usa la siguiente):
#   gsk_…   → Groq (tier gratis)
#   sk-or-… → OpenRouter (la app SOLO usa modelos :free, no consume crédito)
GROQ_API_KEYS = "gsk_primera, gsk_segunda, sk-or-v1-tercera"

# Repo privado de GitHub donde viven las fichas (ej: "usuario/clientes-iproppi")
GITHUB_REPO = "USUARIO/clientes-iproppi"
# Personal Access Token con permiso Contents: Read and write sobre ese repo
GITHUB_PAT = "github_pat_..."
